generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id            Int       @id @default(autoincrement())
  username      String    @unique
  email         String    @unique
  passwordHash  String?   @map("password_hash")
  role          String    @default("Employee")
  status        String    @default("Active")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  auditLogs     AuditLog[]
  sessions      Session[]
  mediaLibrary  MediaLibrary[]

  @@map("users")
}

model Company {
  id                Int            @id @default(autoincrement())
  companyName       String         @map("company_name")
  companyCode       String         @unique @map("company_code")
  companyDescription String?       @map("company_description")
  companyLogo       String?        @map("company_logo")
  companyBanner     String?        @map("company_banner")
  companyFavicon    String?        @map("company_favicon")
  websiteUrl        String?        @map("website_url")
  status            String         @default("Draft")
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")
  mediaLibrary      MediaLibrary[]
  websites          Website[]
  departments       Department[]
  employees         Employee[]
  assets            Asset[]
  projects          Project[]
  complianceRecords ComplianceRecord[]

  @@map("companies")
}

model LeadershipProfile {
  id          Int      @id @default(autoincrement())
  name        String
  designation String
  biography   String?
  photoUrl    String?  @map("photo_url")
  status      String   @default("Active")
  displayOrder Int     @default(0) @map("display_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("leadership_profiles")
}

model OtpVerification {
  id        Int      @id @default(autoincrement())
  email     String
  otp       String
  expiresAt DateTime @map("expires_at")
  used      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([email], map: "idx_otp_email")
  @@map("otp_verifications")
}

model MediaLibrary {
  id          Int      @id @default(autoincrement())
  fileName    String   @map("file_name")
  fileUrl     String   @map("file_url")
  fileType    String   @map("file_type")
  companyId   Int?     @map("company_id")
  uploadedBy  Int?     @map("uploaded_by")
  createdAt   DateTime @default(now()) @map("created_at")

  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  uploader  User?    @relation(fields: [uploadedBy], references: [id], onDelete: SetNull)

  @@index([companyId], map: "idx_media_company")
  @@index([fileType], map: "idx_media_file_type")
  @@map("media_library")
}

model BrandingSettings {
  id             Int      @id @default(autoincrement())
  logoUrl        String?  @map("logo_url")
  faviconUrl     String?  @map("favicon_url")
  bannerUrl      String?  @map("banner_url")
  primaryColor   String?  @map("primary_color")
  secondaryColor String?  @map("secondary_color")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("branding_settings")
}

model AuditLog {
  id          Int      @id @default(autoincrement())
  userId      Int      @map("user_id")
  action      String
  module      String
  description String?
  ipAddress   String?  @map("ip_address")
  userAgent   String?  @map("user_agent")
  timestamp   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_audit_user")
  @@index([module], map: "idx_audit_module")
  @@index([timestamp], map: "idx_audit_timestamp")
  @@map("audit_logs")
}

model Session {
  id           String   @id
  userId       Int      @map("user_id")
  ipAddress    String   @map("ip_address")
  userAgent    String?  @map("user_agent")
  payload      String?
  lastActivity DateTime @default(now()) @map("last_activity")
  createdAt    DateTime @default(now()) @map("created_at")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_sessions_user")
  @@index([lastActivity], map: "idx_sessions_last_activity")
  @@map("sessions")
}

model Website {
  id           Int      @id @default(autoincrement())
  companyId    Int      @map("company_id")
  template     String   @default("corporate")
  status       String   @default("Draft")
  themeSettings Json?   @map("theme_settings")
  navigation   Json?
  domain       String?
  subdomain    String?
  analytics    Json?
  publishedAt  DateTime? @map("published_at")
  archivedAt   DateTime? @map("archived_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  pages      Page[]

  @@index([companyId], map: "idx_websites_company")
  @@index([status], map: "idx_websites_status")
  @@map("websites")
}

model Page {
  id           Int      @id @default(autoincrement())
  websiteId    Int      @map("website_id")
  companyId    Int      @map("company_id")
  pageName     String   @map("page_name")
  pageSlug     String   @map("page_slug")
  pageContent  String?  @map("page_content")
  pageStatus   String   @default("Draft") @map("page_status")
  metaTitle    String?  @map("meta_title")
  metaDescription String? @map("meta_description")
  sortOrder    Int      @default(0) @map("sort_order")
  isRequired   Boolean  @default(false) @map("is_required")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  website Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@index([websiteId], map: "idx_pages_website")
  @@index([companyId], map: "idx_pages_company")
  @@map("pages")
}

model Department {
  id          Int      @id @default(autoincrement())
  companyId   Int      @map("company_id")
  departmentName String @map("department_name")
  departmentCode String @map("department_code")
  description String?
  headId      Int?
  status      String   @default("Active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  company    Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employees  Employee[]

  @@index([companyId], map: "idx_dept_company")
  @@map("departments")
}

model Employee {
  id           Int      @id @default(autoincrement())
  employeeId   String   @unique @map("employee_id")
  companyId    Int      @map("company_id")
  departmentId Int?     @map("department_id")
  fullName     String   @map("full_name")
  email        String
  phone        String?
  designation  String
  managerId    Int?     @map("manager_id")
  role         String   @default("Employee")
  status       String   @default("Active")
  joiningDate  DateTime? @map("joining_date")
  avatar       String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  company    Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  @@index([companyId], map: "idx_emp_company")
  @@index([departmentId], map: "idx_emp_department")
  @@map("employees")
}

model Approval {
  id           Int      @id @default(autoincrement())
  companyId    Int?     @map("company_id")
  employeeId   Int?     @map("employee_id")
  approvalType String   @map("approval_type")
  status       String   @default("Pending")
  requestedBy  Int      @map("requested_by")
  reviewedBy   Int?     @map("reviewed_by")
  reviewNotes  String?  @map("review_notes")
  reviewedAt   DateTime? @map("reviewed_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([companyId], map: "idx_approval_company")
  @@index([status], map: "idx_approval_status")
  @@map("approvals")
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int?     @map("user_id")
  companyId Int?     @map("company_id")
  type      String
  title     String
  message   String
  channel   String   @default("Dashboard")
  isRead    Boolean  @default(false) @map("is_read")
  readAt    DateTime? @map("read_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId], map: "idx_notif_user")
  @@index([isRead], map: "idx_notif_read")
  @@map("notifications")
}

model Report {
  id           Int      @id @default(autoincrement())
  companyId    Int?     @map("company_id")
  reportType   String   @map("report_type")
  reportName   String   @map("report_name")
  reportFormat String   @default("PDF") @map("report_format")
  filters      Json?
  generatedBy  Int      @map("generated_by")
  filePath     String?  @map("file_path")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([companyId], map: "idx_report_company")
  @@map("reports")
}

model Asset {
  id           Int      @id @default(autoincrement())
  companyId    Int      @map("company_id")
  assetName    String   @map("asset_name")
  assetType    String   @map("asset_type")
  serialNumber String?  @map("serial_number")
  value        Float    @default(0)
  assignedTo   Int?     @map("assigned_to")
  status       String   @default("Available")
  purchaseDate DateTime? @map("purchase_date")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId], map: "idx_asset_company")
  @@map("assets")
}

model Document {
  id           Int      @id @default(autoincrement())
  companyId    Int?     @map("company_id")
  documentName String   @map("document_name")
  documentType String   @map("document_type")
  fileUrl      String?  @map("file_url")
  description  String?
  expiryDate   DateTime? @map("expiry_date")
  createdBy    Int      @map("created_by")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([companyId], map: "idx_doc_company")
  @@map("documents")
}

model ComplianceRecord {
  id                Int      @id @default(autoincrement())
  companyId         Int      @map("company_id")
  complianceType    String   @map("compliance_type")
  title             String
  issuingAuthority  String?  @map("issuing_authority")
  issueDate         DateTime? @map("issue_date")
  expiryDate        DateTime @map("expiry_date")
  status            String   @default("Active")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId], map: "idx_compliance_company")
  @@map("compliance_records")
}

model AiInsight {
  id             Int      @id @default(autoincrement())
  companyId      Int?     @map("company_id")
  insightType    String   @map("insight_type")
  title          String
  description    String
  confidenceScore Float   @default(0) @map("confidence_score")
  isRead         Boolean  @default(false) @map("is_read")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([companyId], map: "idx_ai_company")
  @@map("ai_insights")
}

model SearchIndex {
  id          Int      @id @default(autoincrement())
  entityType  String   @map("entity_type")
  entityId    Int      @map("entity_id")
  title       String
  description String?
  keywords    String?
  url         String?
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([entityType], map: "idx_search_type")
  @@index([title], map: "idx_search_title")
  @@map("search_index")
}

model Project {
  id          Int      @id @default(autoincrement())
  companyId   Int      @map("company_id")
  projectName String   @map("project_name")
  description String?
  status      String   @default("Planning")
  startDate   DateTime? @map("start_date")
  endDate     DateTime? @map("end_date")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId], map: "idx_project_company")
  @@map("projects")
}

model Task {
  id          Int      @id @default(autoincrement())
  projectId   Int?     @map("project_id")
  companyId   Int      @map("company_id")
  taskName    String   @map("task_name")
  assignedTo  Int?     @map("assigned_to")
  status      String   @default("Pending")
  priority    String   @default("Medium")
  dueDate     DateTime? @map("due_date")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([projectId], map: "idx_task_project")
  @@map("tasks")
}
